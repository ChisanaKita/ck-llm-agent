# LLM Agent Backend Environment Configuration
# Copy this file to .env and update the values as needed

# Application Settings
APP_NAME="LLM Agent Backend"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8080
WORKERS=1

# Logging Settings
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_ACCESS_LOGS=true

# vLLM Configuration
VLLM__CHAT_BASE_URL=http://localhost:8000
VLLM__EMBEDDING_BASE_URL=http://localhost:8001
VLLM__CHAT_MODEL=Qwen/Qwen3-8B-AWQ
VLLM__EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VLLM__MAX_RETRIES=3
VLLM__TIMEOUT=60
VLLM__CONNECTION_POOL_SIZE=10

# ChromaDB Configuration
CHROMADB__PERSIST_DIRECTORY=./data/chromadb
CHROMADB__COLLECTION_NAME=tool_embeddings
CHROMADB__EMBEDDING_DIMENSION=1024
CHROMADB__SIMILARITY_METRIC=cosine

# Authentication (optional - uncomment to enable)
# AUTH__SECRET_KEY=your-secret-key-here-change-in-production
# AUTH__ALGORITHM=HS256
# AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=30
# AUTH__API_KEY_HEADER=X-API-Key

# Rate Limiting
RATE_LIMIT__REQUESTS_PER_MINUTE=60
RATE_LIMIT__BURST_SIZE=10
RATE_LIMIT__ENABLE_RATE_LIMITING=true

# MCP Configuration
MCP__CONFIG_PATH=./.kiro/settings/mcp.json
MCP__AUTO_DISCOVER=true
MCP__TOOL_SELECTION_LIMIT=5

# Performance Settings
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=300
ENABLE_CACHING=true
CACHE_TTL=3600

# Health Check Settings
HEALTH_CHECK_INTERVAL=30
DEPENDENCY_TIMEOUT=5

# HuggingFace Token
HF_TOKEN=your-huggingface-token-here

# External vLLM Endpoints (for Runpod or other external services)
# Uncomment and configure if using external vLLM servers
# VLLM__CHAT_BASE_URL=https://your-runpod-chat-endpoint.com
# VLLM__EMBEDDING_BASE_URL=https://your-runpod-embedding-endpoint.com

# Production Settings (uncomment for production deployment)
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING
# WORKERS=4
# AUTH__SECRET_KEY=your-production-secret-key